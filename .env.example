# Generate a long random value for this application credential.
CHAT_API_KEY=replace-with-a-long-random-secret
# Gemini API key from Google AI Studio. Never commit the real value.
GOOGLE_API_KEY=replace-with-your-gemini-api-key
# Optional: override the allowlisted models with JSON.
# MODEL_ROUTES={"default":{"provider":"gemini","model":"gemini-flash-latest"},"flash-lite":{"provider":"gemini","model":"gemini-3.5-flash-lite"}}
DEFAULT_MODEL=default
SESSION_DB_URL=sqlite+aiosqlite:///./chat_sessions.db
CHAT_TIMEOUT_SECONDS=60
